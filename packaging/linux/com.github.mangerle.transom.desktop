# Transom 桌面条目：任务栏入口 + `ssh://` 链接处理程序注册。
#
# Type=Application 而不是 Link：只有 Application 条目会被桌面环境当作
# URL scheme handler 候选（靠 MimeType 匹配），Link 条目仅用于启动器。
# %u 让桌面环境把 `ssh://[user@]host[:port]` 作为单个 argv 参数传入；
# 没有地址的普通启动不带参数，走既有会话列表。
#
# 单实例：transom 启动时先绑定实例套接字，已有实例在跑则把地址转交后退出，
# 因此反复点击链接只会在同一个窗口里开新标签，不会堆出多个进程。
#
# 默认程序不在启动时自动改写：`ssh://` 处理程序与默认终端在各发行版常由
# 既有终端占用，静默抢占会影响用户工作流。接管只发生在设置页"设为默认
# 终端"开关被显式打开时（由应用写入条目与偏好列表），或用户手工执行安装
# 说明里的命令。
[Desktop Entry]
Type=Application
Version=1.0
Name=Transom
GenericName=SSH Client
GenericName[zh_CN]=SSH 客户端
Comment=Native SSH, serial console and terminal workspace with integrated SFTP
Comment[zh_CN]=原生 SSH、串口与终端工作台，内置 SFTP 文件传输
# Exec 用可执行文件名，安装到 PATH 后即可解析；打包前缀变化时无需改动本行。
# （应用内"设为默认终端"开关生成的条目写的是绝对路径，两者解析结果一致。）
Exec=transom %u
# Icon 是不带扩展名的主题名，对应 hicolor/scalable/apps/<此名>.svg；
# 安装说明会复制 logo/transom-logo.svg 到该落点。矢量出图在任何尺寸下都
# 没有颗粒感，手写文件名（如 Icon=transom）指不到资产只会显示默认图标。
Icon=com.github.mangerle.transom
Terminal=false
# 主分类只留 System：`Network` 与 `System` 同属主分类，并列会让应用在菜单里
# 出现两次；而附加分类 `RemoteAccess` 又要求配 `Network`——两条
# desktop-file-validate 提示互相拉扯，所以两者都不写，与 Ptyxis 的
# `System;TerminalEmulator;` 对齐。远程属性由 GenericName/Comment/Keywords
# 表达，不靠分类。TerminalEmulator 必须保留：`xdg-terminal-exec` 与文件
# 管理器就是按这个分类找候选终端的。
Categories=System;TerminalEmulator;
Keywords=ssh;sftp;serial;terminal;远程登录;串口;终端;
StartupNotify=true
StartupWMClass=com.github.mangerle.transom
MimeType=x-scheme-handler/ssh;
# 默认终端规范：文件管理器"在终端打开"经 xdg-terminal-exec 拉起时，把目标
# 目录拼成 --dir=<路径> 显式传给 Exec（缺该键时 launcher 只会自己 cd，已有
# 实例的交接路径拿不到目录）。
X-TerminalArgDir=--dir=
